//@version=6
indicator("POC Multi-TF [visual]", shorttitle="POC MTF", overlay=true, max_lines_count=500, max_labels_count=500, max_bars_back=5000)

// ============================================================================
// POC Multi-Timeframe — VISUAL. POCs iguais em QUALQUER timeframe do gráfico.
// Histograma a partir de uma resolução FIXA (request.security_lower_tf).
// Períodos: 1D, 2D, 3D, 5D, 1W, 2W, 1M. Linhas pontilhadas até ao eixo + tags
// "POC:TF preço" encostadas à direita (estilo POCKY). Não envia webhooks.
// ⚠️ A "Resolução de amostragem" tem de ser MENOR que o TF do gráfico.
// ============================================================================
g = "POC Multi-Timeframe"
ltf       = input.timeframe("15", "Resolução de amostragem", options=["1", "3", "5", "15", "30", "60"], group=g, tooltip="Resolução fixa do histograma. TEM de ser menor que o TF do gráfico. Menor = mais preciso, menos alcance.")
bins      = input.int(24, "Bins do perfil de volume", minval=10, maxval=50, group=g)
show_live = input.bool(true, "Mostrar POC do período ATUAL (tracejado)", group=g)

gd = "Períodos (liga · quantos manter · cor)"
show_1d = input.bool(true, "1D", inline="1d", group=gd)
keep_1d = input.int(15, "", inline="1d", group=gd)
c_1d    = input.color(color.rgb(158, 158, 158), "", inline="1d", group=gd)
show_2d = input.bool(true, "2D", inline="2d", group=gd)
keep_2d = input.int(10, "", inline="2d", group=gd)
c_2d    = input.color(color.rgb(120, 144, 156), "", inline="2d", group=gd)
show_3d = input.bool(true, "3D", inline="3d", group=gd)
keep_3d = input.int(8, "", inline="3d", group=gd)
c_3d    = input.color(color.rgb(100, 181, 246), "", inline="3d", group=gd)
show_5d = input.bool(true, "5D", inline="5d", group=gd)
keep_5d = input.int(8, "", inline="5d", group=gd)
c_5d    = input.color(color.rgb(129, 199, 132), "", inline="5d", group=gd)
show_1w = input.bool(true, "1W", inline="1w", group=gd)
keep_1w = input.int(8, "", inline="1w", group=gd)
c_1w    = input.color(color.rgb(149, 117, 205), "", inline="1w", group=gd)
show_2w = input.bool(true, "2W", inline="2w", group=gd)
keep_2w = input.int(6, "", inline="2w", group=gd)
c_2w    = input.color(color.rgb(186, 104, 200), "", inline="2w", group=gd)
show_1m = input.bool(true, "1M", inline="1m", group=gd)
keep_1m = input.int(6, "", inline="1m", group=gd)
c_1m    = input.color(color.rgb(255, 167, 38), "", inline="1m", group=gd)

// ---- POC de um bucket (histograma de volume) ----
f_poc(array<float> px, array<float> vol, int nb) =>
    float poc = na
    int n = array.size(px)
    if n > 0
        float lo = array.min(px)
        float hi = array.max(px)
        float rng = hi - lo
        if rng <= 0
            poc := array.get(px, 0)
        else
            bv = array.new_float(nb, 0.0)
            float bw = rng / nb
            for i = 0 to n - 1
                int idx = math.min(nb - 1, math.max(0, int((array.get(px, i) - lo) / bw)))
                array.set(bv, idx, array.get(bv, idx) + array.get(vol, i))
            poc := lo + (array.indexof(bv, array.max(bv)) + 0.5) * bw
    poc

// ---- Buckets + listas de desenhos (7 períodos) ----
var array<float> b1d_px=array.new_float(), var array<float> b1d_v=array.new_float(), var array<line> l1d=array.new_line(), var array<label> t1d=array.new_label()
var array<float> b2d_px=array.new_float(), var array<float> b2d_v=array.new_float(), var array<line> l2d=array.new_line(), var array<label> t2d=array.new_label()
var array<float> b3d_px=array.new_float(), var array<float> b3d_v=array.new_float(), var array<line> l3d=array.new_line(), var array<label> t3d=array.new_label()
var array<float> b5d_px=array.new_float(), var array<float> b5d_v=array.new_float(), var array<line> l5d=array.new_line(), var array<label> t5d=array.new_label()
var array<float> b1w_px=array.new_float(), var array<float> b1w_v=array.new_float(), var array<line> l1w=array.new_line(), var array<label> t1w=array.new_label()
var array<float> b2w_px=array.new_float(), var array<float> b2w_v=array.new_float(), var array<line> l2w=array.new_line(), var array<label> t2w=array.new_label()
var array<float> b1m_px=array.new_float(), var array<float> b1m_v=array.new_float(), var array<line> l1m=array.new_line(), var array<label> t1m=array.new_label()

// ---- Finaliza um período fechado: desenha POC (linha pontilhada + tag) e limpa ----
f_push(array<float> px, array<float> vol, array<line> lns, array<label> lbs, color c, string txt, int keep) =>
    float poc = f_poc(px, vol, bins)
    if not na(poc)
        ln = line.new(bar_index, poc, bar_index + 1, poc, color=color.new(c, 20), width=1, style=line.style_dotted, extend=extend.right)
        lb = label.new(bar_index, poc, "POC:" + txt + " " + str.tostring(poc, format.mintick), style=label.style_label_right, color=color.new(c, 25), textcolor=color.white, size=size.small)
        array.push(lns, ln)
        array.push(lbs, lb)
        if array.size(lns) > keep
            line.delete(array.shift(lns))
            label.delete(array.shift(lbs))
    array.clear(px)
    array.clear(vol)

// ---- Acumula uma amostra (preço, volume) em todos os buckets ativos ----
f_accum(float p, float v) =>
    if show_1d
        array.push(b1d_px, p), array.push(b1d_v, v)
    if show_2d
        array.push(b2d_px, p), array.push(b2d_v, v)
    if show_3d
        array.push(b3d_px, p), array.push(b3d_v, v)
    if show_5d
        array.push(b5d_px, p), array.push(b5d_v, v)
    if show_1w
        array.push(b1w_px, p), array.push(b1w_v, v)
    if show_2w
        array.push(b2w_px, p), array.push(b2w_v, v)
    if show_1m
        array.push(b1m_px, p), array.push(b1m_v, v)

// ---- Reancorar as tags à direita (encostadas ao eixo) ----
f_anchor(array<label> lbs) =>
    if barstate.islast and array.size(lbs) > 0
        for i = 0 to array.size(lbs) - 1
            label.set_x(array.get(lbs, i), bar_index)

// ---- Amostragem à resolução fixa ----
useChart = timeframe.in_seconds(ltf) >= timeframe.in_seconds()
[ltfP, ltfV] = request.security_lower_tf(syminfo.tickerid, ltf, [hlc3, volume])

if barstate.isconfirmed
    // 1) fechar os períodos que acabaram
    if show_1d and timeframe.change("D")  and array.size(b1d_px) > 0
        f_push(b1d_px, b1d_v, l1d, t1d, c_1d, "1D", keep_1d)
    if show_2d and timeframe.change("2D") and array.size(b2d_px) > 0
        f_push(b2d_px, b2d_v, l2d, t2d, c_2d, "2D", keep_2d)
    if show_3d and timeframe.change("3D") and array.size(b3d_px) > 0
        f_push(b3d_px, b3d_v, l3d, t3d, c_3d, "3D", keep_3d)
    if show_5d and timeframe.change("5D") and array.size(b5d_px) > 0
        f_push(b5d_px, b5d_v, l5d, t5d, c_5d, "5D", keep_5d)
    if show_1w and timeframe.change("W")  and array.size(b1w_px) > 0
        f_push(b1w_px, b1w_v, l1w, t1w, c_1w, "1W", keep_1w)
    if show_2w and timeframe.change("2W") and array.size(b2w_px) > 0
        f_push(b2w_px, b2w_v, l2w, t2w, c_2w, "2W", keep_2w)
    if show_1m and timeframe.change("M")  and array.size(b1m_px) > 0
        f_push(b1m_px, b1m_v, l1m, t1m, c_1m, "1M", keep_1m)
    // 2) acumular as amostras desta barra
    if useChart
        if not na(hlc3) and not na(volume) and volume > 0
            f_accum(hlc3, volume)
    else if not na(ltfP) and array.size(ltfP) > 0
        for i = 0 to array.size(ltfP) - 1
            float p = array.get(ltfP, i)
            float v = na(ltfV) or array.size(ltfV) <= i ? na : array.get(ltfV, i)
            if not na(p) and not na(v) and v > 0
                f_accum(p, v)

// manter as tags encostadas ao eixo
f_anchor(t1d), f_anchor(t2d), f_anchor(t3d), f_anchor(t5d), f_anchor(t1w), f_anchor(t2w), f_anchor(t1m)

// ---- POC do período ATUAL (ao vivo, tracejado) — um por período ----
var line li_1d=na, var label la_1d=na
var line li_2d=na, var label la_2d=na
var line li_3d=na, var label la_3d=na
var line li_5d=na, var label la_5d=na
var line li_1w=na, var label la_1w=na
var line li_2w=na, var label la_2w=na
var line li_1m=na, var label la_1m=na

// desenha/atualiza uma linha+tag "ao vivo" (inline por período, pois usa var)
if show_1d and show_live and barstate.islast and array.size(b1d_px) > 0
    float p = f_poc(b1d_px, b1d_v, bins)
    if not na(p)
        li_1d := na(li_1d) ? line.new(bar_index, p, bar_index+1, p, color=color.new(c_1d,0), style=line.style_dashed, extend=extend.right) : li_1d
        la_1d := na(la_1d) ? label.new(bar_index, p, "", style=label.style_label_right, color=color.new(c_1d,15), textcolor=color.white, size=size.small) : la_1d
        line.set_xy1(li_1d, bar_index, p), line.set_xy2(li_1d, bar_index+1, p)
        label.set_xy(la_1d, bar_index, p), label.set_text(la_1d, "POC:1D• " + str.tostring(p, format.mintick))
if show_2d and show_live and barstate.islast and array.size(b2d_px) > 0
    float p = f_poc(b2d_px, b2d_v, bins)
    if not na(p)
        li_2d := na(li_2d) ? line.new(bar_index, p, bar_index+1, p, color=color.new(c_2d,0), style=line.style_dashed, extend=extend.right) : li_2d
        la_2d := na(la_2d) ? label.new(bar_index, p, "", style=label.style_label_right, color=color.new(c_2d,15), textcolor=color.white, size=size.small) : la_2d
        line.set_xy1(li_2d, bar_index, p), line.set_xy2(li_2d, bar_index+1, p)
        label.set_xy(la_2d, bar_index, p), label.set_text(la_2d, "POC:2D• " + str.tostring(p, format.mintick))
if show_3d and show_live and barstate.islast and array.size(b3d_px) > 0
    float p = f_poc(b3d_px, b3d_v, bins)
    if not na(p)
        li_3d := na(li_3d) ? line.new(bar_index, p, bar_index+1, p, color=color.new(c_3d,0), style=line.style_dashed, extend=extend.right) : li_3d
        la_3d := na(la_3d) ? label.new(bar_index, p, "", style=label.style_label_right, color=color.new(c_3d,15), textcolor=color.white, size=size.small) : la_3d
        line.set_xy1(li_3d, bar_index, p), line.set_xy2(li_3d, bar_index+1, p)
        label.set_xy(la_3d, bar_index, p), label.set_text(la_3d, "POC:3D• " + str.tostring(p, format.mintick))
if show_5d and show_live and barstate.islast and array.size(b5d_px) > 0
    float p = f_poc(b5d_px, b5d_v, bins)
    if not na(p)
        li_5d := na(li_5d) ? line.new(bar_index, p, bar_index+1, p, color=color.new(c_5d,0), style=line.style_dashed, extend=extend.right) : li_5d
        la_5d := na(la_5d) ? label.new(bar_index, p, "", style=label.style_label_right, color=color.new(c_5d,15), textcolor=color.white, size=size.small) : la_5d
        line.set_xy1(li_5d, bar_index, p), line.set_xy2(li_5d, bar_index+1, p)
        label.set_xy(la_5d, bar_index, p), label.set_text(la_5d, "POC:5D• " + str.tostring(p, format.mintick))
if show_1w and show_live and barstate.islast and array.size(b1w_px) > 0
    float p = f_poc(b1w_px, b1w_v, bins)
    if not na(p)
        li_1w := na(li_1w) ? line.new(bar_index, p, bar_index+1, p, color=color.new(c_1w,0), style=line.style_dashed, extend=extend.right) : li_1w
        la_1w := na(la_1w) ? label.new(bar_index, p, "", style=label.style_label_right, color=color.new(c_1w,15), textcolor=color.white, size=size.small) : la_1w
        line.set_xy1(li_1w, bar_index, p), line.set_xy2(li_1w, bar_index+1, p)
        label.set_xy(la_1w, bar_index, p), label.set_text(la_1w, "POC:1W• " + str.tostring(p, format.mintick))
if show_2w and show_live and barstate.islast and array.size(b2w_px) > 0
    float p = f_poc(b2w_px, b2w_v, bins)
    if not na(p)
        li_2w := na(li_2w) ? line.new(bar_index, p, bar_index+1, p, color=color.new(c_2w,0), style=line.style_dashed, extend=extend.right) : li_2w
        la_2w := na(la_2w) ? label.new(bar_index, p, "", style=label.style_label_right, color=color.new(c_2w,15), textcolor=color.white, size=size.small) : la_2w
        line.set_xy1(li_2w, bar_index, p), line.set_xy2(li_2w, bar_index+1, p)
        label.set_xy(la_2w, bar_index, p), label.set_text(la_2w, "POC:2W• " + str.tostring(p, format.mintick))
if show_1m and show_live and barstate.islast and array.size(b1m_px) > 0
    float p = f_poc(b1m_px, b1m_v, bins)
    if not na(p)
        li_1m := na(li_1m) ? line.new(bar_index, p, bar_index+1, p, color=color.new(c_1m,0), style=line.style_dashed, extend=extend.right) : li_1m
        la_1m := na(la_1m) ? label.new(bar_index, p, "", style=label.style_label_right, color=color.new(c_1m,15), textcolor=color.white, size=size.small) : la_1m
        line.set_xy1(li_1m, bar_index, p), line.set_xy2(li_1m, bar_index+1, p)
        label.set_xy(la_1m, bar_index, p), label.set_text(la_1m, "POC:1M• " + str.tostring(p, format.mintick))
