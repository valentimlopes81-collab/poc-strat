//@version=6
indicator("POC Multi-TF [visual]", shorttitle="POC MTF", overlay=true, max_lines_count=500, max_bars_back=5000)

// ============================================================================
// POC Multi-Timeframe — VISUAL. POCs iguais em QUALQUER timeframe do gráfico.
// Histograma a partir de uma resolução FIXA (request.security_lower_tf).
// Períodos CALENDAR: 1D, 2D, 3D, 5D, 1W, 2W, 1M (fecham em fronteiras de calendário).
// Períodos TRAILING (sufixo -T): mesmas durações, mas em janela rolante a partir
// de AGORA (sem esperar fronteira de calendário) — mais densidade/"teia", como
// no indicador de referência. Só linhas (sem labels de texto), roxo para as
// calendar e cinzento para as trailing. Não envia webhooks.
// A "Resolução de amostragem" cai sozinha para 1m se alguma vez deixar de ser
// menor que o TF do gráfico (ex.: desceste para 5m) — não precisas de a mudar.
// ============================================================================
g = "POC Multi-Timeframe"
ltf       = input.timeframe("15", "Resolução de amostragem", options=["1", "3", "5", "15", "30", "60"], group=g, tooltip="Resolução fixa do histograma. Menor = mais preciso, menos alcance de histórico. Se alguma vez deixar de ser menor que o TF do gráfico, o script usa 1m automaticamente — não precisas de mudar isto ao trocar de TF.")
bins      = input.int(24, "Bins do perfil de volume", minval=10, maxval=50, group=g)
show_live = input.bool(true, "Mostrar POC do período ATUAL (tracejado)", group=g)

gc = "Cores e espessura"
c_calendar = input.color(color.rgb(156, 39, 176),  "Cor das POCs calendar (1D..1M)", group=gc)
c_trailing = input.color(color.rgb(120, 120, 120), "Cor das POCs trailing (-T)",     group=gc)
poc_width  = input.int(2, "Espessura das linhas", minval=1, maxval=4, group=gc)
poc_transp = input.int(0, "Transparência (0 = opaca)", minval=0, maxval=90, group=gc)

gd = "Períodos calendar (liga · quantos manter)"
show_1d = input.bool(true, "1D", inline="1d", group=gd)
keep_1d = input.int(15, "", inline="1d", group=gd)
show_2d = input.bool(true, "2D", inline="2d", group=gd)
keep_2d = input.int(10, "", inline="2d", group=gd)
show_3d = input.bool(true, "3D", inline="3d", group=gd)
keep_3d = input.int(8, "", inline="3d", group=gd)
show_5d = input.bool(true, "5D", inline="5d", group=gd)
keep_5d = input.int(8, "", inline="5d", group=gd)
show_1w = input.bool(true, "1W", inline="1w", group=gd)
keep_1w = input.int(8, "", inline="1w", group=gd)
show_2w = input.bool(true, "2W", inline="2w", group=gd)
keep_2w = input.int(6, "", inline="2w", group=gd)
show_1m = input.bool(true, "1M", inline="1m", group=gd)
keep_1m = input.int(6, "", inline="1m", group=gd)

gt = "Períodos TRAILING (janela rolante, sem fecho de calendário — sufixo T)"
show_1dt = input.bool(true, "1D-T", inline="1dt", group=gt)
keep_1dt = input.int(6, "", inline="1dt", group=gt)
show_2dt = input.bool(true, "2D-T", inline="2dt", group=gt)
keep_2dt = input.int(6, "", inline="2dt", group=gt)
show_3dt = input.bool(true, "3D-T", inline="3dt", group=gt)
keep_3dt = input.int(6, "", inline="3dt", group=gt)
show_5dt = input.bool(true, "5D-T", inline="5dt", group=gt)
keep_5dt = input.int(6, "", inline="5dt", group=gt)
show_1wt = input.bool(true, "1W-T", inline="1wt", group=gt)
keep_1wt = input.int(6, "", inline="1wt", group=gt)
show_2wt = input.bool(true, "2W-T", inline="2wt", group=gt)
keep_2wt = input.int(6, "", inline="2wt", group=gt)
show_1mt = input.bool(true, "1M-T", inline="1mt", group=gt)
keep_1mt = input.int(6, "", inline="1mt", group=gt)

// ---- POC de um bucket (histograma de volume) ----
f_poc(array<float> px, array<float> vol, int nb) =>
    float poc = na
    int n = array.size(px)
    if n > 0
        float lo = array.min(px)
        float hi = array.max(px)
        float rng = hi - lo
        if rng <= 0
            poc := array.get(px, 0)
        else
            bv = array.new_float(nb, 0.0)
            float bw = rng / nb
            for i = 0 to n - 1
                int idx = math.min(nb - 1, math.max(0, int((array.get(px, i) - lo) / bw)))
                array.set(bv, idx, array.get(bv, idx) + array.get(vol, i))
            poc := lo + (array.indexof(bv, array.max(bv)) + 0.5) * bw
    poc

// ---- Buckets + listas de desenhos (7 períodos) ----
var array<float> b1d_px=array.new_float(), var array<float> b1d_v=array.new_float(), var array<line> l1d=array.new_line()
var array<float> b2d_px=array.new_float(), var array<float> b2d_v=array.new_float(), var array<line> l2d=array.new_line()
var array<float> b3d_px=array.new_float(), var array<float> b3d_v=array.new_float(), var array<line> l3d=array.new_line()
var array<float> b5d_px=array.new_float(), var array<float> b5d_v=array.new_float(), var array<line> l5d=array.new_line()
var array<float> b1w_px=array.new_float(), var array<float> b1w_v=array.new_float(), var array<line> l1w=array.new_line()
var array<float> b2w_px=array.new_float(), var array<float> b2w_v=array.new_float(), var array<line> l2w=array.new_line()
var array<float> b1m_px=array.new_float(), var array<float> b1m_v=array.new_float(), var array<line> l1m=array.new_line()

// ---- Valores dos POCs fechados + flag "testado" (para o webhook: naked = não testado) ----
var array<float> v1d=array.new_float(), var array<bool> k1d=array.new_bool()
var array<float> v2d=array.new_float(), var array<bool> k2d=array.new_bool()
var array<float> v3d=array.new_float(), var array<bool> k3d=array.new_bool()
var array<float> v5d=array.new_float(), var array<bool> k5d=array.new_bool()
var array<float> v1w=array.new_float(), var array<bool> k1w=array.new_bool()
var array<float> v2w=array.new_float(), var array<bool> k2w=array.new_bool()
var array<float> v1m=array.new_float(), var array<bool> k1m=array.new_bool()

// ---- Finaliza um período fechado: desenha a linha da POC e guarda o valor ----
f_push(array<float> px, array<float> vol, array<line> lns, array<float> vals, array<bool> tst, color c, int keep) =>
    float poc = f_poc(px, vol, bins)
    if not na(poc)
        ln = line.new(bar_index, poc, bar_index + 1, poc, color=color.new(c, poc_transp), width=poc_width, style=line.style_dotted, extend=extend.right)
        array.push(lns, ln)
        array.push(vals, poc)
        array.push(tst, false)
        if array.size(lns) > keep
            line.delete(array.shift(lns))
            array.shift(vals)
            array.shift(tst)
    array.clear(px)
    array.clear(vol)

// ---- Marca como "testado" qualquer POC que a barra atual atravessa (deixa de ser naked) ----
f_mark(array<float> vals, array<bool> tst, float hi, float lo) =>
    if array.size(vals) > 0
        for i = 0 to array.size(vals) - 1
            float lvl = array.get(vals, i)
            if not na(lvl) and not array.get(tst, i) and lo <= lvl and hi >= lvl
                array.set(tst, i, true)

// ---- Amostras BRUTAS (tempo+preço+volume) para as janelas TRAILING ----
// Guardadas à parte dos buckets de calendário; podadas a ~32 dias (cobre o 1M-T).
var array<int>   rawT = array.new_int()
var array<float> rawP = array.new_float()
var array<float> rawV = array.new_float()
MAX_LOOKBACK_MS = 32 * 86400000  // 32 dias em ms (cobre o 1M-T com folga)

f_raw_push(int t, float p, float v) =>
    array.push(rawT, t), array.push(rawP, p), array.push(rawV, v)

f_raw_prune(int now) =>
    while array.size(rawT) > 0 and now - array.get(rawT, 0) > MAX_LOOKBACK_MS
        array.shift(rawT), array.shift(rawP), array.shift(rawV)

// POC sobre a janela dos últimos `durMs` milissegundos a partir de `now`
f_poc_trailing(int now, int durMs) =>
    float pocv = na
    int n = array.size(rawT)
    if n > 0
        int cutoff = now - durMs
        tmpPx = array.new_float()
        tmpV  = array.new_float()
        for i = 0 to n - 1
            if array.get(rawT, i) >= cutoff
                array.push(tmpPx, array.get(rawP, i))
                array.push(tmpV, array.get(rawV, i))
        pocv := f_poc(tmpPx, tmpV, bins)
    pocv

// ---- Histórico empilhado das TRAILING (uma marca por vela fechada — "teia") ----
var array<line>  ldt1d=array.new_line()
var array<line>  ldt2d=array.new_line()
var array<line>  ldt3d=array.new_line()
var array<line>  ldt5d=array.new_line()
var array<line>  ldt1w=array.new_line()
var array<line>  ldt2w=array.new_line()
var array<line>  ldt1m=array.new_line()

f_push_val(float pocv, array<line> lns, color c, int keep) =>
    if not na(pocv)
        ln = line.new(bar_index, pocv, bar_index + 1, pocv, color=color.new(c, poc_transp), width=poc_width, style=line.style_dotted, extend=extend.right)
        array.push(lns, ln)
        if array.size(lns) > keep
            line.delete(array.shift(lns))

// ---- Acumula uma amostra (preço, volume) em todos os buckets ativos ----
f_accum(float p, float v) =>
    if show_1d
        array.push(b1d_px, p), array.push(b1d_v, v)
    if show_2d
        array.push(b2d_px, p), array.push(b2d_v, v)
    if show_3d
        array.push(b3d_px, p), array.push(b3d_v, v)
    if show_5d
        array.push(b5d_px, p), array.push(b5d_v, v)
    if show_1w
        array.push(b1w_px, p), array.push(b1w_v, v)
    if show_2w
        array.push(b2w_px, p), array.push(b2w_v, v)
    if show_1m
        array.push(b1m_px, p), array.push(b1m_v, v)

// ---- Amostragem à resolução fixa ----
// Se a resolução escolhida (`ltf`) deixar de ser menor que o TF do gráfico
// (ex.: desceste para 5m com ltf=15), request.security_lower_tf ficaria numa
// resolução inválida e o script para de desenhar tudo, sem aviso claro.
// Corrige-se sozinho: cai automaticamente para "1" (1 minuto), que é sempre
// menor que qualquer TF que uses (5m, 15m, 30m, ...) — nunca mais precisas de
// mexer na "Resolução de amostragem" ao mudar de TF do gráfico.
bool ltf_invalid = timeframe.in_seconds(ltf) >= timeframe.in_seconds()
effective_ltf = ltf_invalid ? "1" : ltf
[ltfP, ltfV, ltfT] = request.security_lower_tf(syminfo.tickerid, effective_ltf, [hlc3, volume, time])

if barstate.isconfirmed
    // 0) marcar POCs que a barra atual atravessou (deixam de ser naked)
    f_mark(v1d, k1d, high, low), f_mark(v2d, k2d, high, low), f_mark(v3d, k3d, high, low)
    f_mark(v5d, k5d, high, low), f_mark(v1w, k1w, high, low), f_mark(v2w, k2w, high, low), f_mark(v1m, k1m, high, low)
    // 1) fechar os períodos que acabaram
    if show_1d and timeframe.change("D")  and array.size(b1d_px) > 0
        f_push(b1d_px, b1d_v, l1d, v1d, k1d, c_calendar, keep_1d)
    if show_2d and timeframe.change("2D") and array.size(b2d_px) > 0
        f_push(b2d_px, b2d_v, l2d, v2d, k2d, c_calendar, keep_2d)
    if show_3d and timeframe.change("3D") and array.size(b3d_px) > 0
        f_push(b3d_px, b3d_v, l3d, v3d, k3d, c_calendar, keep_3d)
    if show_5d and timeframe.change("5D") and array.size(b5d_px) > 0
        f_push(b5d_px, b5d_v, l5d, v5d, k5d, c_calendar, keep_5d)
    if show_1w and timeframe.change("W")  and array.size(b1w_px) > 0
        f_push(b1w_px, b1w_v, l1w, v1w, k1w, c_calendar, keep_1w)
    if show_2w and timeframe.change("2W") and array.size(b2w_px) > 0
        f_push(b2w_px, b2w_v, l2w, v2w, k2w, c_calendar, keep_2w)
    if show_1m and timeframe.change("M")  and array.size(b1m_px) > 0
        f_push(b1m_px, b1m_v, l1m, v1m, k1m, c_calendar, keep_1m)
    // 2) acumular as amostras desta barra (calendar + brutas p/ trailing)
    //    effective_ltf é sempre válido (menor que o TF do gráfico), por isso
    //    usa-se sempre o loop de amostras da resolução mais fina.
    if not na(ltfP) and array.size(ltfP) > 0
        for i = 0 to array.size(ltfP) - 1
            float p = array.get(ltfP, i)
            float v = na(ltfV) or array.size(ltfV) <= i ? na : array.get(ltfV, i)
            int   t = na(ltfT) or array.size(ltfT) <= i ? na : array.get(ltfT, i)
            if not na(p) and not na(v) and v > 0
                f_accum(p, v)
                if not na(t)
                    f_raw_push(t, p, v)
    f_raw_prune(time)

// ---- POC do período ATUAL (ao vivo, tracejado) — um por período ----
var line li_1d=na
var line li_2d=na
var line li_3d=na
var line li_5d=na
var line li_1w=na
var line li_2w=na
var line li_1m=na

// desenha/atualiza uma linha "ao vivo" (inline por período, pois usa var)
if show_1d and show_live and barstate.islast and array.size(b1d_px) > 0
    float p = f_poc(b1d_px, b1d_v, bins)
    if not na(p)
        li_1d := na(li_1d) ? line.new(bar_index, p, bar_index+1, p, color=color.new(c_calendar,poc_transp), width=poc_width, style=line.style_dashed, extend=extend.right) : li_1d
        line.set_xy1(li_1d, bar_index, p), line.set_xy2(li_1d, bar_index+1, p)
if show_2d and show_live and barstate.islast and array.size(b2d_px) > 0
    float p = f_poc(b2d_px, b2d_v, bins)
    if not na(p)
        li_2d := na(li_2d) ? line.new(bar_index, p, bar_index+1, p, color=color.new(c_calendar,poc_transp), width=poc_width, style=line.style_dashed, extend=extend.right) : li_2d
        line.set_xy1(li_2d, bar_index, p), line.set_xy2(li_2d, bar_index+1, p)
if show_3d and show_live and barstate.islast and array.size(b3d_px) > 0
    float p = f_poc(b3d_px, b3d_v, bins)
    if not na(p)
        li_3d := na(li_3d) ? line.new(bar_index, p, bar_index+1, p, color=color.new(c_calendar,poc_transp), width=poc_width, style=line.style_dashed, extend=extend.right) : li_3d
        line.set_xy1(li_3d, bar_index, p), line.set_xy2(li_3d, bar_index+1, p)
if show_5d and show_live and barstate.islast and array.size(b5d_px) > 0
    float p = f_poc(b5d_px, b5d_v, bins)
    if not na(p)
        li_5d := na(li_5d) ? line.new(bar_index, p, bar_index+1, p, color=color.new(c_calendar,poc_transp), width=poc_width, style=line.style_dashed, extend=extend.right) : li_5d
        line.set_xy1(li_5d, bar_index, p), line.set_xy2(li_5d, bar_index+1, p)
if show_1w and show_live and barstate.islast and array.size(b1w_px) > 0
    float p = f_poc(b1w_px, b1w_v, bins)
    if not na(p)
        li_1w := na(li_1w) ? line.new(bar_index, p, bar_index+1, p, color=color.new(c_calendar,poc_transp), width=poc_width, style=line.style_dashed, extend=extend.right) : li_1w
        line.set_xy1(li_1w, bar_index, p), line.set_xy2(li_1w, bar_index+1, p)
if show_2w and show_live and barstate.islast and array.size(b2w_px) > 0
    float p = f_poc(b2w_px, b2w_v, bins)
    if not na(p)
        li_2w := na(li_2w) ? line.new(bar_index, p, bar_index+1, p, color=color.new(c_calendar,poc_transp), width=poc_width, style=line.style_dashed, extend=extend.right) : li_2w
        line.set_xy1(li_2w, bar_index, p), line.set_xy2(li_2w, bar_index+1, p)
if show_1m and show_live and barstate.islast and array.size(b1m_px) > 0
    float p = f_poc(b1m_px, b1m_v, bins)
    if not na(p)
        li_1m := na(li_1m) ? line.new(bar_index, p, bar_index+1, p, color=color.new(c_calendar,poc_transp), width=poc_width, style=line.style_dashed, extend=extend.right) : li_1m
        line.set_xy1(li_1m, bar_index, p), line.set_xy2(li_1m, bar_index+1, p)

// ---- Empilha uma "fotografia" da POC trailing sempre que nasce uma barra ----
// ---- nova (bar_index muda) — dá a "teia" de marcas históricas do indicador ----
// ---- de referência, sem repetir o cálculo pesado em todo o histórico: só ----
// ---- corre quando barstate.islast, e no máximo 1x por barra (guarda de bar_index). ----
var int stackedBar = na
if barstate.islast and bar_index != stackedBar
    if show_1dt
        f_push_val(f_poc_trailing(time, 1 * 86400000),  ldt1d, c_trailing, keep_1dt)
    if show_2dt
        f_push_val(f_poc_trailing(time, 2 * 86400000),  ldt2d, c_trailing, keep_2dt)
    if show_3dt
        f_push_val(f_poc_trailing(time, 3 * 86400000),  ldt3d, c_trailing, keep_3dt)
    if show_5dt
        f_push_val(f_poc_trailing(time, 5 * 86400000),  ldt5d, c_trailing, keep_5dt)
    if show_1wt
        f_push_val(f_poc_trailing(time, 7 * 86400000),  ldt1w, c_trailing, keep_1wt)
    if show_2wt
        f_push_val(f_poc_trailing(time, 14 * 86400000), ldt2w, c_trailing, keep_2wt)
    if show_1mt
        f_push_val(f_poc_trailing(time, 30 * 86400000), ldt1m, c_trailing, keep_1mt)
    stackedBar := bar_index

// ---- POCs TRAILING (janela rolante) — mesmo padrão "ao vivo" de cima, mas a ----
// ---- fonte é a janela dos últimos N dias/semanas a partir de agora, não o ----
// ---- bucket do período de calendário. Atualiza em cada tick, sem esperar ----
// ---- fecho de vela (por isso aparece logo, ao contrário do que fazia antes). ----
var line lidt1d=na
var line lidt2d=na
var line lidt3d=na
var line lidt5d=na
var line lidt1w=na
var line lidt2w=na
var line lidt1m=na

if show_1dt and barstate.islast
    float p = f_poc_trailing(time, 1 * 86400000)
    if not na(p)
        lidt1d := na(lidt1d) ? line.new(bar_index, p, bar_index+1, p, color=color.new(c_trailing,poc_transp), width=poc_width, style=line.style_dashed, extend=extend.right) : lidt1d
        line.set_xy1(lidt1d, bar_index, p), line.set_xy2(lidt1d, bar_index+1, p)
if show_2dt and barstate.islast
    float p = f_poc_trailing(time, 2 * 86400000)
    if not na(p)
        lidt2d := na(lidt2d) ? line.new(bar_index, p, bar_index+1, p, color=color.new(c_trailing,poc_transp), width=poc_width, style=line.style_dashed, extend=extend.right) : lidt2d
        line.set_xy1(lidt2d, bar_index, p), line.set_xy2(lidt2d, bar_index+1, p)
if show_3dt and barstate.islast
    float p = f_poc_trailing(time, 3 * 86400000)
    if not na(p)
        lidt3d := na(lidt3d) ? line.new(bar_index, p, bar_index+1, p, color=color.new(c_trailing,poc_transp), width=poc_width, style=line.style_dashed, extend=extend.right) : lidt3d
        line.set_xy1(lidt3d, bar_index, p), line.set_xy2(lidt3d, bar_index+1, p)
if show_5dt and barstate.islast
    float p = f_poc_trailing(time, 5 * 86400000)
    if not na(p)
        lidt5d := na(lidt5d) ? line.new(bar_index, p, bar_index+1, p, color=color.new(c_trailing,poc_transp), width=poc_width, style=line.style_dashed, extend=extend.right) : lidt5d
        line.set_xy1(lidt5d, bar_index, p), line.set_xy2(lidt5d, bar_index+1, p)
if show_1wt and barstate.islast
    float p = f_poc_trailing(time, 7 * 86400000)
    if not na(p)
        lidt1w := na(lidt1w) ? line.new(bar_index, p, bar_index+1, p, color=color.new(c_trailing,poc_transp), width=poc_width, style=line.style_dashed, extend=extend.right) : lidt1w
        line.set_xy1(lidt1w, bar_index, p), line.set_xy2(lidt1w, bar_index+1, p)
if show_2wt and barstate.islast
    float p = f_poc_trailing(time, 14 * 86400000)
    if not na(p)
        lidt2w := na(lidt2w) ? line.new(bar_index, p, bar_index+1, p, color=color.new(c_trailing,poc_transp), width=poc_width, style=line.style_dashed, extend=extend.right) : lidt2w
        line.set_xy1(lidt2w, bar_index, p), line.set_xy2(lidt2w, bar_index+1, p)
if show_1mt and barstate.islast
    float p = f_poc_trailing(time, 30 * 86400000)
    if not na(p)
        lidt1m := na(lidt1m) ? line.new(bar_index, p, bar_index+1, p, color=color.new(c_trailing,poc_transp), width=poc_width, style=line.style_dashed, extend=extend.right) : lidt1m
        line.set_xy1(lidt1m, bar_index, p), line.set_xy2(lidt1m, bar_index+1, p)

// ============================================================================
// DIVERGÊNCIAS (RSI) — mesma lógica do indicador RSI, agora aqui no preço.
// FASE 1: setinhas + invalidação + alertas simples. (Webhook = fase seguinte.)
// ============================================================================
gdv = "Divergências (RSI clássica)"
show_div   = input.bool(true, "Mostrar divergências (setinhas)", group=gdv)
show_inval = input.bool(true, "Marcar invalidação (✖)", group=gdv)
rsi_len    = input.int(14, "RSI Length", minval=2, group=gdv)
lbR        = input.int(1, "Pivot lookback direita", minval=1, group=gdv, tooltip="Atraso do sinal em velas. 1 = deteta ~ao fecho da vela a seguir ao pivô (mais rápido, mais ruído). 2-3 = ligeiro filtro.")
lbL        = input.int(5, "Pivot lookback esquerda", minval=1, group=gdv)
rgU        = input.int(60, "Máx. barras entre pivôs", minval=1, group=gdv)
rgL        = input.int(5,  "Mín. barras entre pivôs", minval=1, group=gdv)
c_bull     = input.color(color.rgb(38, 166, 154), "Bull", group=gdv)
c_bear     = input.color(color.rgb(239, 83, 80),  "Bear", group=gdv)

_chg = ta.change(close)
_u = ta.rma(math.max(_chg, 0), rsi_len)
_d = ta.rma(-math.min(_chg, 0), rsi_len)
rsi_v = _d == 0 ? 100.0 : _u == 0 ? 0.0 : 100.0 - 100.0 / (1.0 + _u / _d)

_inRange(bool cond) =>
    bars = ta.barssince(cond)
    rgL <= bars and bars <= rgU

rsiLBR  = rsi_v[lbR]
plFound = not na(ta.pivotlow(rsi_v, lbL, lbR))
phFound = not na(ta.pivothigh(rsi_v, lbL, lbR))

// Bullish: preço faz lower low, RSI faz higher low
rsiHL   = rsiLBR > ta.valuewhen(plFound, rsiLBR, 1) and _inRange(plFound[1])
priceLL = low[lbR] < ta.valuewhen(plFound, low[lbR], 1)
bull_div = priceLL and rsiHL and plFound

// Bearish: preço faz higher high, RSI faz lower high
rsiLH   = rsiLBR < ta.valuewhen(phFound, rsiLBR, 1) and _inRange(phFound[1])
priceHH = high[lbR] > ta.valuewhen(phFound, high[lbR], 1)
bear_div = priceHH and rsiLH and phFound

// ---- Densidade de POCs (a "teia") à volta do preço — filtro de setup completo ----
gq = "Qualidade do sinal (teia + MTF)"
require_density = input.bool(true, "Exigir POCs próximos (filtro)", group=gq, tooltip="ON = seta+alerta só quando há div E POCs por perto (tu triagens). OFF = alerta em qualquer div.")
dens_band_pct  = input.float(0.5, "Banda de proximidade (%)", minval=0.1, step=0.1, group=gq)
dens_min       = input.int(1, "Mín. de POCs na banda", minval=1, group=gq, tooltip="1 = basta 1 POC próximo (sensível, tu triagens). Sobe para 2-3 se quiseres só clusters densos (teia).")
f_cnt(array<float> a, float ref, float tol) =>
    int c = 0
    if array.size(a) > 0
        for i = 0 to array.size(a) - 1
            float v = array.get(a, i)
            if not na(v) and math.abs(v - ref) <= tol
                c += 1
    c
float tolabs = close * dens_band_pct / 100.0
int density = f_cnt(v1d, close, tolabs) + f_cnt(v2d, close, tolabs) + f_cnt(v3d, close, tolabs) + f_cnt(v5d, close, tolabs) + f_cnt(v1w, close, tolabs) + f_cnt(v2w, close, tolabs) + f_cnt(v1m, close, tolabs)
bool dense_zone = not require_density or density >= dens_min
// setup completo = divergência DENTRO da teia (ou div pura se o filtro estiver OFF)
bool bull_setup = bull_div and (dense_zone or not require_density)
bool bear_setup = bear_div and (dense_zone or not require_density)

// setinhas no preço (no pivô, lbR barras atrás) — SÓ no setup completo
plotshape(show_div and bull_setup ? low[lbR]  : na, title="Bull setup", offset=-lbR, style=shape.triangleup,   location=location.absolute, color=c_bull, size=size.small)
plotshape(show_div and bear_setup ? high[lbR] : na, title="Bear setup", offset=-lbR, style=shape.triangledown, location=location.absolute, color=c_bear, size=size.small)

// invalidação: bull cai se fechar abaixo do fundo; bear cai se fechar acima do topo
var float bull_iv=na, var bool bull_active=false
var float bear_iv=na, var bool bear_active=false
if bull_div
    bull_iv := low[lbR],  bull_active := true
if bear_div
    bear_iv := high[lbR], bear_active := true
bull_inval = bull_active and not bull_div and not na(bull_iv) and close < bull_iv
bear_inval = bear_active and not bear_div and not na(bear_iv) and close > bear_iv
if bull_inval
    bull_active := false
if bear_inval
    bear_active := false
plotshape(show_inval and bull_inval ? low  : na, title="Bull inval", style=shape.xcross, location=location.belowbar, color=color.new(color.gray, 0), size=size.tiny)
plotshape(show_inval and bear_inval ? high : na, title="Bear inval", style=shape.xcross, location=location.abovebar, color=color.new(color.gray, 0), size=size.tiny)

// alertas simples (sem webhook — para uso manual no diálogo "Add Alert")
alertcondition(bull_div,   title="Bull Div (POC MTF)",             message="{{ticker}}: Divergência BULLISH")
alertcondition(bear_div,   title="Bear Div (POC MTF)",             message="{{ticker}}: Divergência BEARISH")
alertcondition(bull_inval, title="Bull Div INVALIDADA (POC MTF)",  message="{{ticker}}: Bull div invalidada")
alertcondition(bear_inval, title="Bear Div INVALIDADA (POC MTF)",  message="{{ticker}}: Bear div invalidada")

// ============================================================================
// Divergências multi-TF (3 TFs explícitos, ex.: 5/15/30) — independentes do
// TF do gráfico (via request.security). Confluência para ajuste de risco.
// ============================================================================
mtf_on = input.bool(true, "Divergências multi-TF", group=gq)
div_tf1 = input.timeframe("5",  "TF 1", inline="mtf", group=gq)
div_tf2 = input.timeframe("15", "TF 2", inline="mtf", group=gq)
div_tf3 = input.timeframe("30", "TF 3", inline="mtf", group=gq, tooltip="Podem ser abaixo ou acima do TF do gráfico. Confluência = quantos destes divergem.")

f_divs() =>
    float chg = ta.change(close)
    float u = ta.rma(math.max(chg, 0), rsi_len)
    float d = ta.rma(-math.min(chg, 0), rsi_len)
    float r = d == 0 ? 100.0 : u == 0 ? 0.0 : 100.0 - 100.0 / (1.0 + u / d)
    float rlbr = r[lbR]
    bool pl = not na(ta.pivotlow(r, lbL, lbR))
    bool ph = not na(ta.pivothigh(r, lbL, lbR))
    int bpl = ta.barssince(pl[1])
    int bph = ta.barssince(ph[1])
    bool rhl = rlbr > ta.valuewhen(pl, rlbr, 1) and bpl >= rgL and bpl <= rgU
    bool pll = low[lbR] < ta.valuewhen(pl, low[lbR], 1)
    bool bull = pll and rhl and pl
    bool rlh = rlbr < ta.valuewhen(ph, rlbr, 1) and bph >= rgL and bph <= rgU
    bool phh = high[lbR] > ta.valuewhen(ph, high[lbR], 1)
    bool bear = phh and rlh and ph
    [bull, bear]

[b1, s1] = request.security(syminfo.tickerid, div_tf1, f_divs())
[b2, s2] = request.security(syminfo.tickerid, div_tf2, f_divs())
[b3, s3] = request.security(syminfo.tickerid, div_tf3, f_divs())
int bull_conf = mtf_on ? (b1 ? 1 : 0) + (b2 ? 1 : 0) + (b3 ? 1 : 0) : (bull_div ? 1 : 0)
int bear_conf = mtf_on ? (s1 ? 1 : 0) + (s2 ? 1 : 0) + (s3 ? 1 : 0) : (bear_div ? 1 : 0)

// leitura visual no canto: densidade da teia + confluência de divergências
var table qt = table.new(position.top_right, 1, 3, border_width=1)
if barstate.islast
    table.cell(qt, 0, 0, "teia: " + str.tostring(density) + " POCs", text_color=color.white, bgcolor=color.new(dense_zone ? color.teal : color.gray, 25), text_size=size.small)
    table.cell(qt, 0, 1, "bull conf: " + str.tostring(bull_conf) + "/3", text_color=color.white, bgcolor=color.new(c_bull, 35), text_size=size.small)
    table.cell(qt, 0, 2, "bear conf: " + str.tostring(bear_conf) + "/3", text_color=color.white, bgcolor=color.new(c_bear, 35), text_size=size.small)

// alertas simples do setup completo (div + teia), se preferires ao alert() JSON
alertcondition(bull_setup, title="Bull SETUP (div + teia)", message="{{ticker}}: Bull setup — div em zona DENSA de POCs")
alertcondition(bear_setup, title="Bear SETUP (div + teia)", message="{{ticker}}: Bear setup — div em zona DENSA de POCs")

// ============================================================================
// SETUPS por TF explícito (5/15/30) — alertas PRÓPRIOS, independentes do TF do
// gráfico. As POCs (density/dense_zone) já são calculadas de forma TF-agnóstica
// (resolução fixa `ltf`, não o TF do gráfico), por isso servem tal-e-qual para
// qualificar a divergência de QUALQUER um dos 3 TFs — nunca precisas de abrir
// o gráfico em 5m para isto disparar.
// ============================================================================
bull_setup_tf1 = mtf_on and b1 and dense_zone
bear_setup_tf1 = mtf_on and s1 and dense_zone
bull_setup_tf2 = mtf_on and b2 and dense_zone
bear_setup_tf2 = mtf_on and s2 and dense_zone
bull_setup_tf3 = mtf_on and b3 and dense_zone
bear_setup_tf3 = mtf_on and s3 and dense_zone

plotshape(bull_setup_tf1 ? low  : na, title="Bull setup TF1", style=shape.triangleup,   location=location.belowbar, color=color.new(c_bull, 40), size=size.tiny)
plotshape(bear_setup_tf1 ? high : na, title="Bear setup TF1", style=shape.triangledown, location=location.abovebar, color=color.new(c_bear, 40), size=size.tiny)
plotshape(bull_setup_tf2 ? low  : na, title="Bull setup TF2", style=shape.triangleup,   location=location.belowbar, color=color.new(c_bull, 20), size=size.tiny)
plotshape(bear_setup_tf2 ? high : na, title="Bear setup TF2", style=shape.triangledown, location=location.abovebar, color=color.new(c_bear, 20), size=size.tiny)
plotshape(bull_setup_tf3 ? low  : na, title="Bull setup TF3", style=shape.triangleup,   location=location.belowbar, color=c_bull, size=size.tiny)
plotshape(bear_setup_tf3 ? high : na, title="Bear setup TF3", style=shape.triangledown, location=location.abovebar, color=c_bear, size=size.tiny)

alertcondition(bull_setup_tf1, title="Bull SETUP TF1 (div+teia)", message="{{ticker}}: Bull setup no TF1 — div + POC perto")
alertcondition(bear_setup_tf1, title="Bear SETUP TF1 (div+teia)", message="{{ticker}}: Bear setup no TF1 — div + POC perto")
alertcondition(bull_setup_tf2, title="Bull SETUP TF2 (div+teia)", message="{{ticker}}: Bull setup no TF2 — div + POC perto")
alertcondition(bear_setup_tf2, title="Bear SETUP TF2 (div+teia)", message="{{ticker}}: Bear setup no TF2 — div + POC perto")
alertcondition(bull_setup_tf3, title="Bull SETUP TF3 (div+teia)", message="{{ticker}}: Bull setup no TF3 — div + POC perto")
alertcondition(bear_setup_tf3, title="Bear SETUP TF3 (div+teia)", message="{{ticker}}: Bear setup no TF3 — div + POC perto")
// Um único alerta "qualquer um dos 3" — cria UM alerta no TradingView com esta
// condição se preferires só 1 notificação em vez de 6 separadas.
alertcondition(bull_setup_tf1 or bull_setup_tf2 or bull_setup_tf3, title="Bull SETUP — qualquer TF (5/15/30)", message="{{ticker}}: Bull setup em 5m, 15m ou 30m — div + POC perto")
alertcondition(bear_setup_tf1 or bear_setup_tf2 or bear_setup_tf3, title="Bear SETUP — qualquer TF (5/15/30)", message="{{ticker}}: Bear setup em 5m, 15m ou 30m — div + POC perto")

// ---- Versão que gasta só 1 slot de alerta (plano Essential = 20 slots) ----
// Em vez de criares um alerta por condição, cria UM único alerta neste
// indicador com a condição "Any alert() function call" — cobre as 6
// combinações TF/direção acima (e, se ligares o webhook mais à frente,
// também esses). A mensagem diz sempre qual(ais) disparou.
string tf_alert_msg = ""
if bull_setup_tf1
    tf_alert_msg := tf_alert_msg + (tf_alert_msg == "" ? "" : " | ") + "BULL 5m"
if bear_setup_tf1
    tf_alert_msg := tf_alert_msg + (tf_alert_msg == "" ? "" : " | ") + "BEAR 5m"
if bull_setup_tf2
    tf_alert_msg := tf_alert_msg + (tf_alert_msg == "" ? "" : " | ") + "BULL 15m"
if bear_setup_tf2
    tf_alert_msg := tf_alert_msg + (tf_alert_msg == "" ? "" : " | ") + "BEAR 15m"
if bull_setup_tf3
    tf_alert_msg := tf_alert_msg + (tf_alert_msg == "" ? "" : " | ") + "BULL 30m"
if bear_setup_tf3
    tf_alert_msg := tf_alert_msg + (tf_alert_msg == "" ? "" : " | ") + "BEAR 30m"
if tf_alert_msg != ""
    alert(syminfo.ticker + ": " + tf_alert_msg + " — div + POC perto", alert.freq_once_per_bar_close)

// ============================================================================
// WEBHOOK poc-strat — envia o MESMO payload que o MAX V2 enviava, mas agora
// disparado pela divergência RSI clássica DESTE indicador + preço numa zona
// forte de POCs (naked, dentro da banda %). Server NÃO muda.
// Gatilho: bull_div -> long / bear_div -> short, só se houver POC naked na zona.
// ============================================================================
gwh = "Webhook (poc-strat)"
enable_webhook = input.bool(false, "Ativar envio de webhook", group=gwh, tooltip="OFF por omissão. Liga aqui E cria um alerta 'Any alert() function call' neste indicador. Não esqueças de DESLIGAR o alerta do MAX V2 para não abrir trades duplicadas.")
webhook_secret = input.string("O_TEU_SEGREDO", "Segredo (tem de bater certo com o servidor)", group=gwh)
zone_band_pct  = input.float(1.5, "Banda da zona (%) à volta do preço", minval=0.1, step=0.1, group=gwh, tooltip="Um POC conta para a 'zona forte' se estiver a <= esta % do preço.")

// --- serializar POCs naked em JSON (igual ao MAX V2) ---
f_json_levels(string acc, array<float> levels, array<bool> tested, float ref, string mode) =>
    string s = acc
    if array.size(levels) > 0
        for i = 0 to array.size(levels) - 1
            float lvl = array.get(levels, i)
            if not na(lvl) and not array.get(tested, i)
                bool ok = mode == "zone" ? (math.abs(lvl - ref) / ref * 100.0 <= zone_band_pct) : mode == "up" ? (lvl > ref) : (lvl < ref)
                if ok
                    s := s + (s == "" ? "" : ",") + str.tostring(lvl, format.mintick)
    s

f_zone_extreme(float cur, array<float> levels, array<bool> tested, float ref, bool want_min) =>
    float ext = cur
    if array.size(levels) > 0
        for i = 0 to array.size(levels) - 1
            float lvl = array.get(levels, i)
            if not na(lvl) and not array.get(tested, i) and math.abs(lvl - ref) / ref * 100.0 <= zone_band_pct
                ext := na(ext) ? lvl : (want_min ? math.min(ext, lvl) : math.max(ext, lvl))
    ext

// zone_pocs: POCs naked de TODOS os períodos dentro da banda à volta do preço
string zj = ""
zj := f_json_levels(zj, v1d, k1d, close, "zone")
zj := f_json_levels(zj, v2d, k2d, close, "zone")
zj := f_json_levels(zj, v3d, k3d, close, "zone")
zj := f_json_levels(zj, v5d, k5d, close, "zone")
zj := f_json_levels(zj, v1w, k1w, close, "zone")
zj := f_json_levels(zj, v2w, k2w, close, "zone")
zj := f_json_levels(zj, v1m, k1m, close, "zone")

// zona forte válida = cluster DENSO de POCs (teia) se require_density; senão ≥1 POC naked na banda
bool valid_strong_zone = dense_zone  // = a mesma condição das setas (div + POCs próximos) → seta e alerta batem certo
bool sniper_long_setup  = enable_webhook and bull_div and valid_strong_zone
bool sniper_short_setup = enable_webhook and bear_div and valid_strong_zone

if sniper_long_setup or sniper_short_setup
    string side_str = sniper_long_setup ? "long" : "short"

    string up = ""
    up := f_json_levels(up, v1d, k1d, close, "up")
    up := f_json_levels(up, v2d, k2d, close, "up")
    up := f_json_levels(up, v3d, k3d, close, "up")
    up := f_json_levels(up, v5d, k5d, close, "up")
    up := f_json_levels(up, v1w, k1w, close, "up")
    up := f_json_levels(up, v2w, k2w, close, "up")
    up := f_json_levels(up, v1m, k1m, close, "up")

    string dn = ""
    dn := f_json_levels(dn, v1d, k1d, close, "down")
    dn := f_json_levels(dn, v2d, k2d, close, "down")
    dn := f_json_levels(dn, v3d, k3d, close, "down")
    dn := f_json_levels(dn, v5d, k5d, close, "down")
    dn := f_json_levels(dn, v1w, k1w, close, "down")
    dn := f_json_levels(dn, v2w, k2w, close, "down")
    dn := f_json_levels(dn, v1m, k1m, close, "down")

    float zb = na
    bool want_min = side_str == "long"
    zb := f_zone_extreme(zb, v1d, k1d, close, want_min)
    zb := f_zone_extreme(zb, v2d, k2d, close, want_min)
    zb := f_zone_extreme(zb, v3d, k3d, close, want_min)
    zb := f_zone_extreme(zb, v5d, k5d, close, want_min)
    zb := f_zone_extreme(zb, v1w, k1w, close, want_min)
    zb := f_zone_extreme(zb, v2w, k2w, close, want_min)
    zb := f_zone_extreme(zb, v1m, k1m, close, want_min)
    if na(zb)
        zb := side_str == "long" ? close * 0.99 : close * 1.01

    int conf = side_str == "long" ? bull_conf : bear_conf
    string payload = '{"ticker":"' + syminfo.ticker + '","side":"' + side_str + '","price":' + str.tostring(close, format.mintick) + ',"zone_pocs":[' + zj + '],"targets_up":[' + up + '],"targets_down":[' + dn + '],"zone_break":' + str.tostring(zb, format.mintick) + ',"density":' + str.tostring(density) + ',"confluence":' + str.tostring(conf) + ',"secret":"' + webhook_secret + '"}'

    alert(payload, alert.freq_once_per_bar_close)
