//@version=5
indicator("Quant Levels (GEX) - NQ", overlay=true, max_lines_count=10, max_labels_count=10)

// Cola aqui os niveis que o Claude te der (equivalente NQ, nao QQQ) e a linha desenha-se sozinha.
// Deixa a 0 para esconder um nivel que nao tenhas hoje.

call_wall      = input.float(0, "Call Wall",             group="Niveis GEX (full dataset)")
put_wall       = input.float(0, "Put Wall",               group="Niveis GEX (full dataset)")
zero_gamma     = input.float(0, "Zero-Gamma",             group="Niveis GEX (full dataset)")

call_res_0dte  = input.float(0, "Call Resistance 0DTE",   group="Niveis 0DTE")
put_sup_0dte   = input.float(0, "Put Support 0DTE",       group="Niveis 0DTE")

show_labels    = input.bool(true, "Mostrar labels", group="Estilo")
line_width     = input.int(1, "Espessura", minval=1, maxval=4, group="Estilo")

col_call  = color.new(color.red, 0)
col_put   = color.new(color.red, 0)
col_zero  = color.new(color.orange, 0)
col_0dte  = color.new(color.purple, 0)

plot_level(level, col, txt, style) =>
    if level != 0
        line.new(bar_index[1], level, bar_index, level, extend=extend.right, color=col, width=line_width, style=style)
        if show_labels
            label.new(bar_index, level, txt, style=label.style_label_left, color=color.new(col, 85), textcolor=col, size=size.small)

if barstate.islast
    plot_level(call_wall,     col_call, "call wall",       line.style_solid)
    plot_level(put_wall,      col_put,  "put wall",         line.style_solid)
    plot_level(zero_gamma,    col_zero, "zero",             line.style_dashed)
    plot_level(call_res_0dte, col_0dte, "call res 0dte",    line.style_dotted)
    plot_level(put_sup_0dte,  col_0dte, "put supp 0dte",    line.style_dotted)
