//@version=6
// ============================================================================
// NQ NY-Session [indicador] — para testar em BAR REPLAY.
// Mesma lógica da strategy, mas mostra SINAIS visuais (LONG/SHORT) com o
// stop e o alvo sugeridos, em vez de abrir trades. Agnóstico ao volume
// (usa volume real do NQ1!/MNQ1! ou perfil por tempo/TPO no US100).
//
// SINAL = divergência RSI clássica + DENTRO da janela de NY + preço encostado
//         a uma zona (POC dia anterior / VAH / VAL / overnight / VWAP / POC hoje).
// ⚠️ Usar em 5min (ou 1min). Timezone America/New_York (DST-safe).
// ============================================================================
indicator("NQ NY-Session [indicador]", shorttitle="NQ NY", overlay=true,
     max_lines_count=500, max_labels_count=500, max_bars_back=5000)

// ---------------- Sessão / horário ----------------
gs = "Sessão (Nova Iorque)"
tz       = "America/New_York"
rth_sess = input.session("0930-1600", "Sessão RTH (para os perfis)", group=gs)
win_sess = input.session("0930-1130", "Janela de SINAL (manhã)", group=gs)

// ---------------- Perfil ----------------
gp = "Perfil de volume"
bins   = input.int(30, "Bins", minval=10, maxval=60, group=gp)
va_pct = input.float(70, "Value Area (%)", minval=50, maxval=90, group=gp) / 100.0
z_pd   = input.bool(true, "Zona: POC/VAH/VAL dia anterior", group=gp)
z_on   = input.bool(true, "Zona: POC overnight", group=gp)
z_vwap = input.bool(true, "Zona: VWAP", group=gp)
z_dev  = input.bool(true, "Zona: POC a desenvolver (hoje)", group=gp)

// ---------------- Divergências ----------------
gdv = "Divergências (RSI clássica)"
rsi_len=input.int(14,"RSI Length",minval=2,group=gdv)
lbR=input.int(5,"Pivot dir",minval=1,group=gdv)
lbL=input.int(5,"Pivot esq",minval=1,group=gdv)
rgU=input.int(60,"Máx barras entre pivôs",minval=1,group=gdv)
rgL=input.int(5,"Mín barras entre pivôs",minval=1,group=gdv)

// ---------------- Sinal / níveis sugeridos ----------------
gx = "Sinal"
atr_len  = input.int(14, "ATR Length", minval=2, group=gx)
band_atr = input.float(0.30, "Proximidade à zona (× ATR)", minval=0.05, step=0.05, group=gx)
stop_atr = input.float(1.20, "Stop sugerido (× ATR)", minval=0.2, step=0.1, group=gx)
tp_mode  = input.string("Próxima zona", "Alvo sugerido", options=["Próxima zona","R fixo"], group=gx)
tp_r     = input.float(2.0, "R fixo (se escolhido / fallback)", minval=0.5, step=0.5, group=gx)
show_lvls= input.bool(true, "Desenhar stop/alvo no sinal", group=gx)

// ---------------- Perfil: POC + Value Area ----------------
f_profile(array<float> px, array<float> w, int nb, float vap) =>
    float poc=na
    float vah=na
    float val=na
    int n = array.size(px)
    if n > 0
        float lo=array.min(px), float hi=array.max(px)
        if hi > lo
            bv = array.new_float(nb, 0.0)
            float bw = (hi-lo)/nb
            for i=0 to n-1
                int idx = math.min(nb-1, math.max(0, int((array.get(px,i)-lo)/bw)))
                array.set(bv, idx, array.get(bv,idx)+array.get(w,i))
            int pidx = array.indexof(bv, array.max(bv))
            poc := lo + (pidx+0.5)*bw
            float total = array.sum(bv)
            float tgt = total*vap
            float acc = array.get(bv, pidx)
            int up=pidx, dn=pidx
            while acc < tgt and (up < nb-1 or dn > 0)
                float aup = up < nb-1 ? array.get(bv, up+1) : -1.0
                float adn = dn > 0    ? array.get(bv, dn-1) : -1.0
                if aup >= adn
                    up += 1
                    acc += aup > 0 ? aup : 0.0
                else
                    dn -= 1
                    acc += adn > 0 ? adn : 0.0
            vah := lo + (up+1)*bw
            val := lo + dn*bw
        else
            poc := array.get(px,0), vah := poc, val := poc
    [poc, vah, val]

// ---------------- Sessão ----------------
in_rth   = not na(time(timeframe.period, rth_sess, tz))
in_win   = not na(time(timeframe.period, win_sess, tz))
rth_open = in_rth and not in_rth[1]
rth_close= not in_rth and in_rth[1]

var array<float> rth_px=array.new_float(), var array<float> rth_w=array.new_float()
var array<float> on_px =array.new_float(), var array<float> on_w =array.new_float()
var float pd_poc=na, var float pd_vah=na, var float pd_val=na
var float on_poc=na
var float dev_poc=na

if barstate.isconfirmed
    float w = na(volume) or volume == 0 ? 1.0 : volume
    float p = hlc3
    if in_rth
        array.push(rth_px, p), array.push(rth_w, w)
    else
        array.push(on_px, p), array.push(on_w, w)
    if rth_close
        [pc, vh, vl] = f_profile(rth_px, rth_w, bins, va_pct)
        pd_poc := pc, pd_vah := vh, pd_val := vl
        array.clear(rth_px), array.clear(rth_w)
    if rth_open
        [opc, _oh, _ol] = f_profile(on_px, on_w, bins, va_pct)
        on_poc := opc
        array.clear(on_px), array.clear(on_w)
    if in_rth and array.size(rth_px) > 0
        [dpc, _dh, _dl] = f_profile(rth_px, rth_w, bins, va_pct)
        dev_poc := dpc

vwap_v = ta.vwap(hlc3)

// ---------------- Divergências ----------------
_chg=ta.change(close)
_u=ta.rma(math.max(_chg,0),rsi_len)
_d=ta.rma(-math.min(_chg,0),rsi_len)
rsi_v = _d==0 ? 100.0 : _u==0 ? 0.0 : 100.0-100.0/(1.0+_u/_d)
_inRange(bool c) =>
    b = ta.barssince(c)
    rgL <= b and b <= rgU
rsiLBR  = rsi_v[lbR]
plFound = not na(ta.pivotlow(rsi_v, lbL, lbR))
phFound = not na(ta.pivothigh(rsi_v, lbL, lbR))
bull_div = (low[lbR] < ta.valuewhen(plFound, low[lbR], 1)) and (rsiLBR > ta.valuewhen(plFound, rsiLBR, 1) and _inRange(plFound[1])) and plFound
bear_div = (high[lbR] > ta.valuewhen(phFound, high[lbR], 1)) and (rsiLBR < ta.valuewhen(phFound, rsiLBR, 1) and _inRange(phFound[1])) and phFound

// ---------------- Zonas ----------------
atr = ta.atr(atr_len)
var array<float> zones = array.new_float()
array.clear(zones)
if z_pd and not na(pd_poc)
    array.push(zones, pd_poc)
if z_pd and not na(pd_vah)
    array.push(zones, pd_vah)
if z_pd and not na(pd_val)
    array.push(zones, pd_val)
if z_on and not na(on_poc)
    array.push(zones, on_poc)
if z_vwap and not na(vwap_v)
    array.push(zones, vwap_v)
if z_dev and not na(dev_poc)
    array.push(zones, dev_poc)

f_near_any(float ref, float tol) =>
    bool hit=false
    if array.size(zones) > 0
        for i=0 to array.size(zones)-1
            if math.abs(ref - array.get(zones, i)) <= tol
                hit := true
    hit
f_next(float ref, bool above) =>
    float best=na
    if array.size(zones) > 0
        for i=0 to array.size(zones)-1
            float z = array.get(zones, i)
            if (above ? z > ref : z < ref)
                if na(best) or math.abs(z-ref) < math.abs(best-ref)
                    best := z
    best

tol = band_atr * atr
zone_near = f_near_any(close, tol)

// ---------------- SINAL ----------------
long_sig  = in_win and bull_div and zone_near
short_sig = in_win and bear_div and zone_near

// níveis sugeridos + etiqueta com Entrada/Stop/Alvo
if show_lvls and (long_sig or short_sig)
    float sp = stop_atr * atr
    float e  = close
    float st = long_sig ? e - sp : e + sp
    float nz = f_next(e, long_sig)
    bool nz_ok = long_sig ? (not na(nz) and nz - e >= sp) : (not na(nz) and e - nz >= sp)
    float tp = tp_mode == "Próxima zona" and nz_ok ? nz : (long_sig ? e + tp_r*sp : e - tp_r*sp)
    color cc = long_sig ? color.teal : color.red
    line.new(bar_index, st, bar_index+8, st, color=color.new(color.red,0),   style=line.style_dotted)
    line.new(bar_index, tp, bar_index+8, tp, color=color.new(color.green,0), style=line.style_dotted)
    label.new(bar_index, long_sig ? low : high, (long_sig?"LONG":"SHORT") + "\nE " + str.tostring(e, format.mintick) + "\nSL " + str.tostring(st, format.mintick) + "\nTP " + str.tostring(tp, format.mintick), style=long_sig?label.style_label_up:label.style_label_down, color=color.new(cc,15), textcolor=color.white, size=size.small)

// ---------------- Visual ----------------
plot(z_pd  and not na(pd_poc) ? pd_poc : na, "PD POC",  color.new(color.orange,0), 2, plot.style_linebr)
plot(z_pd  and not na(pd_vah) ? pd_vah : na, "PD VAH",  color.new(color.orange,50), 1, plot.style_linebr)
plot(z_pd  and not na(pd_val) ? pd_val : na, "PD VAL",  color.new(color.orange,50), 1, plot.style_linebr)
plot(z_on  and not na(on_poc) ? on_poc : na, "ON POC",  color.new(color.purple,0), 1, plot.style_linebr)
plot(z_vwap? vwap_v : na,                    "VWAP",    color.new(color.blue,0),   1)
plot(z_dev and in_rth and not na(dev_poc) ? dev_poc : na, "Dev POC", color.new(color.teal,0), 1, plot.style_linebr)
bgcolor(in_win ? color.new(color.green, 92) : na, title="Janela de sinal")
plotshape(long_sig  ? low  : na, "LONG",  shape.triangleup,   location.belowbar, color.new(color.teal,0), size=size.small)
plotshape(short_sig ? high : na, "SHORT", shape.triangledown, location.abovebar, color.new(color.red,0),  size=size.small)

alertcondition(long_sig,  title="LONG (NQ NY)",  message="{{ticker}}: LONG — divergência bull em zona (janela NY)")
alertcondition(short_sig, title="SHORT (NQ NY)", message="{{ticker}}: SHORT — divergência bear em zona (janela NY)")
